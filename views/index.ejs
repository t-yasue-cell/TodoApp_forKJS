<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>やることリスト</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --danger: #ef4444;
            --danger-hover: #dc2626;
            --success: #22c55e;
            --success-hover: #16a34a;
            --border: #e2e8f0;
            --overdue-bg: #fff1f2;
            --overdue-border: #fecdd3;
            --overdue-text: #e11d48;
            --approaching-bg: #fefce8;
            --approaching-border: #fef08a;
            --approaching-text: #a16207;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Noto Sans JP', sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            line-height: 1.5;
            display: flex;
            justify-content: center;
            height: 100vh;
            overflow: hidden;
        }

        .container {
            width: 100%;
            max-width: 900px;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        header {
            text-align: center;
            margin-bottom: 1.5rem;
            flex-shrink: 0;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: -0.025em;
            color: var(--primary);
        }

        .todo-list {
            list-style: none;
            padding: 0.75rem;
            margin: 0;
            background: #f1f5f9;
            border: 1px solid var(--border);
            border-radius: 16px;
            flex-grow: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
            margin-bottom: 1rem;
        }

        /* スクロールバーのカスタマイズ（Chrome, Safariなど） */
        .todo-list::-webkit-scrollbar {
            width: 6px;
        }

        .todo-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .todo-list::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 20px;
        }

        .todo-item {
            background: var(--card-bg);
            margin-bottom: 0.4rem;
            padding: 1.1rem 1.25rem;
            border-radius: 12px;
            border: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

        .todo-item.overdue {
            background: var(--overdue-bg);
            border-color: var(--overdue-border);
        }

        .todo-item.overdue .todo-title {
            color: var(--overdue-text);
        }

        .todo-item.overdue .period-badge {
            background: #ffe4e6;
            color: var(--overdue-text);
        }

        .todo-item.approaching {
            background: var(--approaching-bg);
            border-color: var(--approaching-border);
        }

        .todo-item.approaching .todo-title {
            color: var(--approaching-text);
        }

        .todo-item.approaching .period-badge {
            background: #fef9c3;
            color: var(--approaching-text);
        }

        .todo-item:last-child {
            margin-bottom: 0;
        }

        .todo-item:hover {
            transform: none;
            box-shadow: none;
        }

        .todo-info {
            flex-grow: 1;
        }

        .todo-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .todo-title {
            font-weight: 600;
            font-size: 1.1rem;
        }

        .overdue-label, .approaching-label {
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.1rem 0.4rem;
            border-radius: 4px;
            text-transform: uppercase;
            margin-left: 0.5rem;
        }

        .overdue-label {
            background: var(--danger);
            color: white;
        }

        .approaching-label {
            background: var(--approaching-text);
            color: white;
        }

        .period-badge {
            background: #eef2ff;
            color: var(--primary);
            padding: 0.2rem 0.6rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .todo-meta {
            font-size: 1rem;
            color: var(--text-main);
            opacity: 0.8;
        }

        .complete-btn {
            background: #fff;
            border: 1px solid var(--border);
            color: #94a3b8;
            cursor: pointer;
            padding: 0.4rem;
            border-radius: 10px;
            transition: all 0.2s;
            margin-left: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

        .complete-btn:hover {
            color: var(--success);
            background: #f0fdf4;
            border-color: var(--success);
            box-shadow: 0 2px 4px rgba(34, 197, 94, 0.1);
        }

        .add-card {
            background: var(--card-bg);
            padding: 0; /* ヘッダーとボディで個別にパディングを設定 */
            border-radius: 16px;
            box-shadow: 0 -4px 6px -1px rgba(0,0,0,0.05);
            border: 1px solid var(--border);
            flex-shrink: 0;
            overflow: hidden;
        }

        .add-card-header {
            padding: 1rem 1.25rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            transition: background 0.2s;
        }

        .add-card-header:hover {
            background: #f8fafc;
        }

        .add-card h2 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .toggle-icon {
            color: var(--text-muted);
            transition: transform 0.3s;
        }

        .add-card.collapsed .toggle-icon {
            transform: rotate(-180deg);
        }

        .add-card-body {
            padding: 0 1.25rem 1.25rem 1.25rem;
            max-height: 500px;
            transition: max-height 0.3s ease-out, opacity 0.2s, padding 0.3s;
            opacity: 1;
            overflow: hidden;
        }

        .add-card.collapsed .add-card-body {
            max-height: 0;
            padding-bottom: 0;
            padding-top: 0;
            opacity: 0;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.3rem;
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        input, select {
            width: 100%;
            padding: 0.6rem 0.75rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
            font-family: inherit;
            transition: border-color 0.2s, ring 0.2s;
        }

        input:focus, select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .form-row {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        @media (max-width: 480px) {
            .form-row {
                gap: 0;
            }
            .form-row > .form-group {
                flex: 1 0 100% !important;
            }
            
            .add-card {
                /* padding: 1rem; は削除。header/bodyで制御するため */
            }

            .add-card-header {
                padding: 0.75rem 1rem;
            }

            .add-card-body {
                padding: 0 1rem 1rem 1rem;
            }

            .add-card.collapsed .add-card-body {
                padding-bottom: 0;
                padding-top: 0;
            }
        }

        .submit-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.75rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            width: 100%;
            transition: background 0.2s;
            margin-top: 0.25rem;
        }

        .submit-btn:hover {
            background: var(--primary-hover);
        }

        .empty-state {
            text-align: center;
            padding: 3rem 0;
            color: var(--text-muted);
            font-style: italic;
        }

        /* フィルターサイドドロワー (Hamburger/Right Drawer) */
        .filter-drawer-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(2px);
            z-index: 998;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.25s ease, visibility 0.25s ease;
        }
        .filter-drawer-backdrop.open {
            opacity: 1;
            visibility: visible;
        }

        .filter-drawer {
            position: fixed;
            top: 0;
            right: -340px;
            width: 320px;
            max-width: 85vw;
            height: 100vh;
            background: #ffffff;
            box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
            z-index: 999;
            transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            padding: 1.5rem;
            box-sizing: border-box;
        }
        .filter-drawer.open {
            right: 0;
        }

        .drawer-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 1.5rem;
        }
        .drawer-header h2 {
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-main);
        }
        .close-drawer-btn {
            background: transparent;
            border: none;
            font-size: 1.25rem;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
            transition: background 0.15s, color 0.15s;
        }
        .close-drawer-btn:hover {
            background: #f1f5f9;
            color: var(--text-main);
        }

        .filter-field {
            margin-bottom: 1.25rem;
        }
        .filter-field label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
        }

        .filter-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.45rem 0.85rem;
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            transition: all 0.15s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }
        .filter-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: #f8fafc;
        }
        .filter-btn.active {
            border-color: var(--primary);
            background: #eef2ff;
            color: var(--primary);
        }
        .active-dot {
            width: 7px;
            height: 7px;
            background-color: var(--primary);
            border-radius: 50%;
            display: inline-block;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                <h1 style="margin: 0;">やることリスト</h1>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        <div style="display: flex; flex-direction: column; align-items: flex-end;">
                            <span style="font-size: 0.875rem; color: var(--text-muted);">
                                ようこそ、<strong><%= currentUser.username || currentUser.email.split('@')[0] %></strong> さん
                            </span>
                            <% if (currentUser.departments && currentUser.departments.length > 0) { %>
                                <span style="font-size: 0.78rem; color: var(--primary); font-weight: 600;">
                                    所属: <%= currentUser.departments.map(d => d.name).join(', ') %>
                                </span>
                            <% } else { %>
                                <span style="font-size: 0.78rem; color: var(--text-muted); font-style: italic;">
                                    所属: なし
                                </span>
                            <% } %>
                        </div>
                        <a href="/todos/profile" style="text-decoration: none; font-size: 0.875rem; color: var(--text-muted); font-weight: 600; padding: 0.4rem 0.8rem; border: 1px solid var(--border); border-radius: 8px; background: #fff; transition: all 0.15s ease;">👤 プロフィール</a>
                        <a href="/todos/departments" style="text-decoration: none; font-size: 0.875rem; color: var(--text-muted); font-weight: 600; padding: 0.4rem 0.8rem; border: 1px solid var(--border); border-radius: 8px; background: #fff; transition: all 0.15s ease;">🏢 部署一覧</a>
                        <a href="/todos/logout" style="text-decoration: none; font-size: 0.875rem; color: var(--danger); font-weight: 600; padding: 0.4rem 0.8rem; border: 1px solid var(--danger-border); border-radius: 8px; background: #fff; transition: all 0.15s ease;">ログアウト</a>

                    <% } else { %>
                        <a href="/todos/login" style="text-decoration: none; font-size: 0.875rem; color: var(--primary); font-weight: 600; padding: 0.4rem 0.8rem; border: 1px solid var(--primary); border-radius: 8px; transition: all 0.15s ease;">ログイン</a>
                        <a href="/todos/register" style="text-decoration: none; font-size: 0.875rem; color: #fff; background-color: var(--primary); font-weight: 600; padding: 0.4rem 0.8rem; border-radius: 8px; transition: all 0.15s ease;">新規登録</a>
                    <% } %>
                </div>
            </div>
        </header>
        
        <!-- 上部フィルターアクションバー -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span id="filterCount" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);"></span>
            <button type="button" class="filter-btn" id="filterToggleBtn" onclick="toggleFilterDrawer()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="8" y1="12" x2="20" y2="12"></line>
                    <line x1="12" y1="18" x2="20" y2="18"></line>
                </svg>
                <span>フィルター</span>
                <span id="activeFilterDot" class="active-dot" style="display: none;"></span>
            </button>
        </div>

        <!-- 右側スライドフィルタードロワー (Hamburger Side Sheet) -->
        <div class="filter-drawer-backdrop" id="filterBackdrop" onclick="closeFilterDrawer()"></div>
        <div class="filter-drawer" id="filterDrawer">
            <div class="drawer-header">
                <h2>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    絞り込みフィルター
                </h2>
                <button type="button" class="close-drawer-btn" onclick="closeFilterDrawer()" title="閉じる">✕</button>
            </div>

            <div style="flex: 1; overflow-y: auto;">
                <!-- 1. 部署フィルター -->
                <div class="filter-field">
                    <label for="filterDepartment">🏢 部署・個人で絞り込み</label>
                    <select id="filterDepartment" onchange="applyFilters()" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 8px; border: 1px solid var(--border); font-size: 0.9rem; background: #f8fafc; outline: none;">
                        <option value="all">すべての部署・個人</option>
                        <option value="personal">👤 個人タスクのみ</option>
                        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.departments) { %>
                            <% currentUser.departments.forEach(dept => { %>
                                <option value="<%= dept.id %>">🏢 <%= dept.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <!-- 2. ステータスフィルター -->
                <div class="filter-field">
                    <label for="filterStatus">⏰ ステータスで絞り込み</label>
                    <select id="filterStatus" onchange="applyFilters()" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 8px; border: 1px solid var(--border); font-size: 0.9rem; background: #f8fafc; outline: none;">
                        <option value="all">すべての状態</option>
                        <option value="overdue">🚨 期限切れ</option>
                        <option value="approaching">⏰ 期限間近</option>
                        <option value="normal">✅ 通常</option>
                    </select>
                </div>
            </div>

            <div style="padding-top: 1rem; border-top: 1px solid var(--border); display: flex; gap: 0.5rem;">
                <button type="button" onclick="resetFilters()" style="flex: 1; padding: 0.6rem; border: 1px solid var(--border); background: #f1f5f9; color: var(--text-muted); border-radius: 8px; font-weight: 600; cursor: pointer;">リセット</button>
                <button type="button" onclick="closeFilterDrawer()" style="flex: 1; padding: 0.6rem; border: none; background: var(--primary); color: #fff; border-radius: 8px; font-weight: 600; cursor: pointer;">完了</button>
            </div>
        </div>

        <ul class="todo-list" id="todoList">
            <% if (todos.length === 0) { %>
                <div class="empty-state">
                    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                        Todoはありません。新しいタスクを追加しましょう。
                    <% } else { %>
                        現在表示できるTodoはありません。<a href="/login" style="color: var(--primary); font-weight: 600;">ログイン</a> してTodoを管理しましょう。
                    <% } %>
                </div>
            <% } %>
            <% 
                const now = new Date();
                const tomorrow = new Date(now.getTime() + 24 * 60 * 60 * 1000);
                todos.forEach(todo => { 
                    const dueDate = new Date(todo.dueDate);
                    const isOverdue = dueDate < now;
                    const isApproaching = !isOverdue && dueDate < tomorrow;
                    
                    let statusClass = '';
                    let statusKey = 'normal';
                    if (isOverdue) { statusClass = 'overdue'; statusKey = 'overdue'; }
                    else if (isApproaching) { statusClass = 'approaching'; statusKey = 'approaching'; }
            %>
                <li class="todo-item <%= statusClass %>"
                    data-department-id="<%= todo.departmentId ? todo.departmentId : 'personal' %>"
                    data-status="<%= statusKey %>"
                    data-period="<%= todo.period || '' %>">
                    <div class="todo-info">
                        <div class="todo-header">
                            <span class="todo-title"><%= todo.title %></span>
                            <% if (isOverdue) { %>
                                <span class="overdue-label">期限切れ</span>
                            <% } else if (isApproaching) { %>
                                <span class="approaching-label">期限間近</span>
                            <% } %>
                            <% if (todo.period && todo.period !== '') { %>
                                <span class="period-badge"><%= todo.period %></span>
                            <% } %>
                            <% if (todo.department) { %>
                                <span class="period-badge" style="background:#e0e7ff; color:#3730a3; font-weight:700;">🏢 <%= todo.department.name %></span>
                            <% } %>
                        </div>
                        <div class="todo-meta">
                            📅 <%= new Date(todo.dueDate).toLocaleString('ja-JP', { dateStyle: 'medium', timeStyle: 'short' }) %>
                            <% if (todo.user && (typeof currentUser === 'undefined' || !currentUser || todo.user.id !== currentUser.id)) { %>
                                · 作成者: <strong><%= todo.user.username || todo.user.email.split('@')[0] %></strong>
                            <% } %>
                        </div>
                    </div>
                    <!-- /todo/:id を使用した RESTful な編集・削除 -->
                    <div style="display: flex; align-items: center; gap: 0.25rem;">
                        <button type="button" class="complete-btn" title="編集" style="color: #6366f1;" onclick="openEditModal(<%= todo.id %>, '<%= todo.title.replace(/'/g, "\\'") %>', '<%= new Date(todo.dueDate).toISOString().split('T')[0] %>', '<%= new Date(todo.dueDate).toTimeString().slice(0,5) %>', '<%= todo.period || '' %>', '<%= todo.departmentId || '' %>')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        </button>
                        <form action="/todo/<%= todo.id %>?_method=DELETE" method="POST" onsubmit="return confirm('完了しましたか？')">
                            <button type="submit" class="complete-btn" title="完了">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </button>
                        </form>
                    </div>
                </li>
            <% }) %>
        </ul>

        <!-- Todo 編集モーダル -->
        <div class="filter-drawer-backdrop" id="editModalBackdrop" onclick="closeEditModal()"></div>
        <div class="add-card" id="editModal" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; width: 90%; max-width: 500px; display: none; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <div class="add-card-header" style="cursor: default;">
                <h2>Todoの編集</h2>
                <button type="button" class="close-drawer-btn" onclick="closeEditModal()">✕</button>
            </div>
            <div class="add-card-body" style="padding-top: 1rem;">
                <form id="editForm" method="POST">
                    <div class="form-group">
                        <label for="editTitle">Title</label>
                        <input type="text" id="editTitle" name="title" required>
                    </div>
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.departments && currentUser.departments.length > 0) { %>
                    <div class="form-group">
                        <label for="editDepartmentId">対象部署 (共有範囲)</label>
                        <select id="editDepartmentId" name="departmentId">
                            <option value="">👤 自分のみ (個人タスク)</option>
                            <% currentUser.departments.forEach(dept => { %>
                                <option value="<%= dept.id %>">🏢 <%= dept.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div class="form-row">
                        <div class="form-group" style="flex: 2;">
                            <label for="editDate">Date</label>
                            <input type="date" id="editDate" name="date" required>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label for="editTime">Time</label>
                            <input type="time" id="editTime" name="time" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="editPeriod">Period</label>
                        <select id="editPeriod" name="period">
                            <option value="auto">✨ 自動判定（時間から計算）</option>
                            <option value="none">なし</option>
                            <option value="朝">朝</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="昼">昼</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                            <option value="7">7</option>
                            <option value="放課後">放課後</option>
                        </select>
                    </div>
                    <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                        <button type="button" onclick="closeEditModal()" style="flex: 1; padding: 0.75rem; border: 1px solid var(--border); background: #f1f5f9; color: var(--text-muted); border-radius: 8px; font-weight: 600; cursor: pointer;">キャンセル</button>
                        <button type="submit" class="submit-btn" style="flex: 1; margin-top: 0;">保存する</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="add-card" id="addCard">
            <div class="add-card-header" onclick="toggleForm()">
                <h2>New Task</h2>
                <div class="toggle-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </div>
            </div>
            <div class="add-card-body">
                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <!-- /todos を使用した RESTful な追加 -->
                    <form action="/todos" method="POST">
                        <div class="form-group">
                            <label for="title">Title</label>
                            <input type="text" id="title" name="title" required placeholder="何をする？">
                        </div>
                        <% if (currentUser.departments && currentUser.departments.length > 0) { %>
                        <div class="form-group">
                            <label for="departmentId">対象部署 (共有範囲)</label>
                            <select id="departmentId" name="departmentId">
                                <option value="">👤 自分のみ (個人タスク)</option>
                                <% currentUser.departments.forEach(dept => { %>
                                    <option value="<%= dept.id %>">🏢 <%= dept.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <% } %>
                        <div class="form-row">
                            <div class="form-group" style="flex: 2;">
                                <label for="date">Date</label>
                                <input type="date" id="date" name="date" required>
                            </div>
                            <div class="form-group" style="flex: 1;">
                                <label for="time">Time</label>
                                <input type="time" id="time" name="time" required value="09:00">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="period">Period</label>
                            <select id="period" name="period">
                                <option value="auto" selected>✨ 自動判定（時間から計算）</option>
                                <option value="none">なし</option>
                                <option value="朝">朝</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="昼">昼</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                                <option value="7">7</option>
                                <option value="放課後">放課後</option>
                            </select>
                        </div>
                        <button type="submit" class="submit-btn">Add Todo</button>
                    </form>
                <% } else { %>
                    <div style="text-align: center; padding: 1.5rem 1rem;">
                        <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.95rem;">
                            タスクを追加・管理するにはログインが必要です。
                        </p>
                        <a href="/todos/login" style="display: inline-block; background-color: var(--primary); color: #fff; text-decoration: none; padding: 0.6rem 1.25rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem;">
                            ログインして始める
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        const dateEl = document.getElementById('date');
        if (dateEl) dateEl.valueAsDate = new Date();

        function toggleForm() {
            const card = document.getElementById('addCard');
            if (!card) return;
            card.classList.toggle('collapsed');
            const isCollapsed = card.classList.contains('collapsed');
            localStorage.setItem('todo-form-collapsed', isCollapsed);
        }

        function toggleFilterDrawer() {
            const drawer = document.getElementById('filterDrawer');
            const backdrop = document.getElementById('filterBackdrop');
            if (drawer && backdrop) {
                const isOpen = drawer.classList.contains('open');
                if (isOpen) {
                    closeFilterDrawer();
                } else {
                    drawer.classList.add('open');
                    backdrop.classList.add('open');
                }
            }
        }

        function closeFilterDrawer() {
            const drawer = document.getElementById('filterDrawer');
            const backdrop = document.getElementById('filterBackdrop');
            if (drawer) drawer.classList.remove('open');
            if (backdrop) backdrop.classList.remove('open');
        }

        function resetFilters() {
            const deptEl = document.getElementById('filterDepartment');
            const statusEl = document.getElementById('filterStatus');
            if (deptEl) deptEl.value = 'all';
            if (statusEl) statusEl.value = 'all';
            applyFilters();
        }

        function applyFilters() {
            const deptVal = document.getElementById('filterDepartment')?.value || 'all';
            const statusVal = document.getElementById('filterStatus')?.value || 'all';

            const items = document.querySelectorAll('.todo-item');
            let visibleCount = 0;

            items.forEach(item => {
                const itemDept = item.getAttribute('data-department-id');
                const itemStatus = item.getAttribute('data-status');

                const matchDept = (deptVal === 'all') ||
                                  (deptVal === 'personal' && itemDept === 'personal') ||
                                  (deptVal === itemDept);

                const matchStatus = (statusVal === 'all') || (itemStatus === statusVal);

                if (matchDept && matchStatus) {
                    item.style.display = 'flex';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // 件数カウント更新
            const countEl = document.getElementById('filterCount');
            if (countEl) {
                countEl.textContent = `${visibleCount} / ${items.length} 件`;
            }

            // アクティブ状態バッジの切替
            const isFiltered = deptVal !== 'all' || statusVal !== 'all';
            const activeDot = document.getElementById('activeFilterDot');
            const filterBtn = document.getElementById('filterToggleBtn');
            if (activeDot) activeDot.style.display = isFiltered ? 'inline-block' : 'none';
            if (filterBtn) filterBtn.classList.toggle('active', isFiltered);
        }

        function openEditModal(id, title, date, time, period, departmentId) {
            const modal = document.getElementById('editModal');
            const backdrop = document.getElementById('editModalBackdrop');
            const form = document.getElementById('editForm');
            if (!modal || !backdrop || !form) return;

            form.action = `/todo/${id}`;
            document.getElementById('editTitle').value = title;
            document.getElementById('editDate').value = date;
            document.getElementById('editTime').value = time;
            
            const deptEl = document.getElementById('editDepartmentId');
            if (deptEl) deptEl.value = departmentId || '';

            const periodEl = document.getElementById('editPeriod');
            if (periodEl) periodEl.value = period || 'none';

            modal.style.display = 'block';
            backdrop.classList.add('open');
        }

        function closeEditModal() {
            const modal = document.getElementById('editModal');
            const backdrop = document.getElementById('editModalBackdrop');
            if (modal) modal.style.display = 'none';
            if (backdrop) backdrop.classList.remove('open');
        }

        // キーボードEscキーでドロワー/モーダル閉じる
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeFilterDrawer();
                closeEditModal();
            }
        });

        // 初期状態の復元
        window.addEventListener('DOMContentLoaded', () => {
            const isCollapsed = localStorage.getItem('todo-form-collapsed') === 'true';
            const addCard = document.getElementById('addCard');
            if (isCollapsed && addCard) {
                addCard.classList.add('collapsed');
            }
            applyFilters();
        });
    </script>
</body>
</html>
